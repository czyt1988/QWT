            "name": "BarChart",
            "shots": [
                { "output": "screenshots/BarChart-grouped.png", "size": "602x432", "variant": "grouped" },
                { "output": "screenshots/BarChart-stacked.png", "size": "602x432", "variant": "stacked" }
            ]
        },
